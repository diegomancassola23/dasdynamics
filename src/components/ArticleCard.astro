---
import Arrow from './Arrow.astro';
import Cover from './Cover.astro';
import { t } from '../i18n';
import { articleUrl, formatDay, type Entry } from '../lib/content';
const { entry, headingLevel = 3 } = Astro.props as { entry: Entry; headingLevel?: 2 | 3 };
const d = entry.data;
const H = (headingLevel === 2 ? "h2" : "h3") as "h3";
---
<article class="card">
  <Cover entry={entry} />
  <div class="body">
    <p class="meta">
      <time datetime={d.date.toISOString().slice(0, 10)}>{formatDay(d.date)}</time>
      {d.series && d.seriesPart && <> · {t('article.seriesPart', { part: d.seriesPart })}</>}
      {d.draft && <> · <strong>{t('articles.draft')}</strong></>}
    </p>
    <H class="title"><a href={articleUrl(entry)}>{d.title}</a></H>
    <p class="dek">{d.description}</p>
    <a href={articleUrl(entry)} class="more" aria-hidden="true" tabindex="-1">{t('articles.readArticle')}<Arrow size={13} /></a>
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--line);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    position: relative;
    min-width: 0;
  }
  .card :global(.night-cover) {
    border-bottom: 4px solid var(--gold);
  }
  .body {
    padding: 22px 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.25;
    font-weight: 600;
  }
  .title a {
    color: var(--ink);
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .card:has(.title a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .card:hover .title a {
    text-decoration: underline;
  }
  .dek {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-2);
  }
  .more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 600;
    font-size: 15px;
  }
</style>
