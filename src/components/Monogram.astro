---
// The D-inside-D monogram: Diego inside Dynamics.
// The outline follows currentColor; the inner D uses --mark-inner (gold: the moon on night grounds).
interface Props {
  size?: number;
  title?: string;
}
const { size = 40, title } = Astro.props;
---
<svg
  class="monogram"
  width={size}
  height={size}
  viewBox="0 0 96 96"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  <path d="M20 25a7 7 0 0 1 7-7h15a30 30 0 0 1 0 60H27a7 7 0 0 1-7-7z" fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="round"></path>
  <path d="M36 36a4 4 0 0 1 4-4h4a16 16 0 0 1 0 32h-4a4 4 0 0 1-4-4z" style="fill: var(--mark-inner, #D99A2B)"></path>
</svg>
