---
import Base from '../layouts/Base.astro';
import NoteRow from './NoteRow.astro';
import { t } from '../i18n';
import { getAll, isNote, verdictUrl, articleUrl, VERDICTS, type Verdict } from '../lib/content';
import { pageTitle } from '../lib/site';
import editorial from '../data/editorial.json';

const { verdict } = Astro.props as { verdict?: Verdict };
const notes = (await getAll()).filter(isNote);
const shown = verdict ? notes.filter((n) => n.data.verdict === verdict) : notes;

const years = [...new Set(shown.map((n) => n.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const allYears = notes.map((n) => n.data.date.getUTCFullYear());
const from = allYears.length ? Math.min(...allYears) : 2014;
const to = allYears.length ? Math.max(...allYears) : 2024;

const kept = notes.length;
const retired = Number(editorial.retired) || 0;
const merged = Number(editorial.merged) || 0;
const onBlogger = kept + retired + merged;
const bridges = (editorial.bridges ?? []) as { years: string; from: string; to: string; slug: string }[];

const title = verdict ? t('archive.verdictTitle', { verdict: t(`verdicts.${verdict}.label`) }) : t('nav.archive');
const description = verdict
  ? `${t(`verdicts.${verdict}.meaning`)} ${t('archive.count', { count: shown.length })}.`
  : t('archive.lead', { from, to });
---
<Base title={pageTitle(title)} description={description} current="archive">
  <div class="wrap page">
    <p class="eyebrow">{t('archive.eyebrow')}</p>
    <h1 class="title">{t('archive.title')}</h1>
    <p class="lead">{t('archive.lead', { from, to })}</p>

    <div class="cols">
      <div class="list-col">
        <div class="toolbar">
          <div class="search" data-search-box hidden>
            <label for="q">{t('archive.searchLabel')}</label>
            <input id="q" type="search" placeholder={t('archive.searchPlaceholder')} autocomplete="off" />
          </div>
          <nav aria-label={t('archive.filterLabel')}>
            <ul class="chips">
              <li><a class="chip" href="/archive/" aria-current={verdict ? undefined : 'page'}>{t('archive.all')}<span class="count">{notes.length}</span></a></li>
              {VERDICTS.map((v) => {
                const n = notes.filter((x) => x.data.verdict === v).length;
                return n > 0 && (
                  <li><a class="chip" href={verdictUrl(v)} aria-current={v === verdict ? 'page' : undefined}>{t(`verdicts.${v}.label`)}<span class="count">{n}</span></a></li>
                );
              })}
            </ul>
          </nav>
        </div>

        {years.map((y) => (
          <section class="year" aria-labelledby={`y-${y}`} data-year>
            <h2 id={`y-${y}`} class="year-h mono">{y}</h2>
            <ul class="rows">
              {shown.filter((n) => n.data.date.getUTCFullYear() === y).map((n) => <NoteRow entry={n} />)}
            </ul>
          </section>
        ))}
        <p class="no-match" data-no-match hidden>{t('archive.noMatch')}</p>
        {shown.length === 0 && <p class="no-match">{t('archive.noMatch')}</p>}
      </div>

      <aside class="side">
        <section aria-labelledby="pass-h" class="band pass">
          <h2 id="pass-h" class="eyebrow">{t('archive.passTitle')}</h2>
          <dl>
            <div><dt>{t('archive.passOnBlogger')}</dt><dd>{onBlogger}</dd></div>
            <div class="soft"><dt>{t('archive.passRetired')}</dt><dd>{retired > 0 ? `−${retired}` : 0}</dd></div>
            <div class="soft"><dt>{t('archive.passMerged')}</dt><dd>{merged > 0 ? `−${merged}` : 0}</dd></div>
            <div class="total"><dt>{t('archive.passKept')}</dt><dd>{kept}</dd></div>
          </dl>
        </section>

        {bridges.length > 0 && (
          <section aria-labelledby="bridge-h" class="box">
            <h2 id="bridge-h" class="box-h">{t('archive.bridgeTitle')}</h2>
            <p class="box-lead">{t('archive.bridgeLead')}</p>
            <ul class="bridges">
              {bridges.map((b) => (
                <li>
                  <span class="mono">{b.years}</span>
                  <span>{b.from} → <a href={articleUrl(b.slug)}>{b.to}</a></span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section aria-labelledby="ver-h" class="box">
          <h2 id="ver-h" class="box-h">{t('archive.verdictsTitle')}</h2>
          <dl class="meanings">
            {VERDICTS.map((v) => (
              <div>
                <dt class={`m-${v}`}>{t(`verdicts.${v}.label`)}</dt>
                <dd>{t(`verdicts.${v}.meaning`)}</dd>
              </div>
            ))}
          </dl>
        </section>
      </aside>
    </div>
  </div>
</Base>

<script is:inline>
  // Progressive enhancement: the search box appears only when JavaScript runs.
  (function () {
    var box = document.querySelector('[data-search-box]');
    var input = document.getElementById('q');
    if (!box || !input) return;
    box.hidden = false;
    var rows = Array.prototype.slice.call(document.querySelectorAll('[data-search]'));
    var years = Array.prototype.slice.call(document.querySelectorAll('[data-year]'));
    var none = document.querySelector('[data-no-match]');
    input.addEventListener('input', function () {
      var words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      var visible = 0;
      rows.forEach(function (r) {
        var text = r.getAttribute('data-search');
        var hit = words.every(function (w) { return text.indexOf(w) !== -1; });
        r.hidden = !hit;
        if (hit) visible++;
      });
      years.forEach(function (y) { y.hidden = !y.querySelector('[data-search]:not([hidden])'); });
      if (none) none.hidden = visible > 0;
    });
  })();
</script>

<style>
  .page {
    padding-top: 72px;
    padding-bottom: 96px;
  }
  .eyebrow {
    margin-bottom: 18px;
  }
  .title {
    margin: 0;
    max-width: 900px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -1px;
  }
  .lead {
    margin: 24px 0 0;
    max-width: 720px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 56px;
    align-items: flex-start;
  }
  .list-col {
    flex: 999 1 640px;
    min-width: 0;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-end;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--ink);
  }
  .search {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .search[hidden] {
    display: none;
  }
  .search label {
    font-size: 13px;
    font-weight: 600;
  }
  .search input {
    min-height: 44px;
    padding: 0 14px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
    font: 400 15px var(--font-sans);
    border-radius: 0;
  }
  .search input::placeholder {
    color: var(--muted);
  }
  .year-h {
    margin: 32px 0 0;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
    color: var(--muted);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .year[hidden],
  .no-match[hidden] {
    display: none;
  }
  .no-match {
    margin: 32px 0 0;
    color: var(--muted);
  }
  .side {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  .pass {
    padding: 28px;
  }
  .pass .eyebrow {
    margin: 0 0 20px;
  }
  .pass dl {
    margin: 0;
  }
  .pass dl > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--band-line);
  }
  .pass dt {
    font-size: 15px;
  }
  .pass dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
  }
  .pass .soft {
    color: var(--band-soft);
  }
  .pass dl > .total {
    border-bottom: 0;
  }
  .pass .total dt {
    font-weight: 600;
  }
  .pass .total dd {
    font-size: 40px;
  }
  .box {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 28px;
  }
  .box-h {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: 22px;
  }
  .box-lead {
    margin: -10px 0 18px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .bridges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .bridges li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 15px;
    line-height: 1.45;
  }
  .bridges .mono {
    font-size: 12px;
    color: var(--muted);
  }
  .meanings {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 14px;
    line-height: 1.5;
  }
  .meanings dt {
    font-weight: 600;
  }
  .meanings dd {
    margin: 2px 0 0;
    color: var(--text-2);
  }
  .m-valid { color: var(--v-valid-fg); }
  .m-changed { color: var(--v-changed-fg); }
  .m-historical { color: var(--muted); }
  .m-to-review { color: var(--accent); }
  @media (max-width: 480px) {
    .page {
      padding-top: 48px;
    }
    .cols {
      margin-top: 40px;
    }
  }
</style>
