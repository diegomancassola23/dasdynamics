---
import Arrow from './Arrow.astro';
import Cover from './Cover.astro';
import { t } from '../i18n';
import { articleUrl, formatDay, type Entry } from '../lib/content';
const { entry } = Astro.props as { entry: Entry };
const d = entry.data;
---
<article class="feature">
  <div class="cover"><Cover entry={entry} /></div>
  <div class="body">
    <p class="meta">
      <time datetime={d.date.toISOString().slice(0, 10)}>{formatDay(d.date)}</time> · {t(`tracks.${d.track}.short`)}
      {d.draft && <> · <strong>{t('articles.draft')}</strong></>}
    </p>
    <h3 class="title"><a href={articleUrl(entry)}>{d.title}</a></h3>
    <p class="dek">{d.description}</p>
    <a href={articleUrl(entry)} class="more" aria-hidden="true" tabindex="-1">{t('articles.readArticle')}<Arrow /></a>
  </div>
</article>

<style>
  .feature {
    flex: 999 1 600px;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    position: relative;
  }
  .cover {
    flex: 1 1 100%;
    border-bottom: 4px solid var(--gold);
  }
  .body {
    flex: 2 1 340px;
    min-width: 0;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.15;
    font-weight: 700;
  }
  .title a {
    color: var(--ink);
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .feature:has(.title a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .feature:hover .title a {
    text-decoration: underline;
  }
  .dek {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .body {
      padding: 24px;
    }
  }
</style>
