---
// "Dynamics 365 Community Super User · 2026 Season 2".
// Links to the dedicated article only when that article is published (drafts are not built in production).
import Arrow from './Arrow.astro';
import { t } from '../i18n';
import { articleUrl, type Entry } from '../lib/content';
import { SUPER_USER_SLUG } from '../lib/site';
const { all } = Astro.props as { all: Entry[] };
const article = all.find((e) => e.id === SUPER_USER_SLUG);
---
<p class="credential">
  <span class="mark" aria-hidden="true">SU</span>
  <span class="text">
    <strong>{t('credential.label')}</strong>
    <span class="mono season">{t('credential.season')}</span>
  </span>
  {article && <a href={articleUrl(article)} class="read">{t('credential.readMore')}<Arrow size={13} /></a>}
</p>

<style>
  .credential {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 32px 0 0;
    padding: 10px 16px 10px 10px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    font-size: 15px;
  }
  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
  }
  .text {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    align-items: baseline;
  }
  .season {
    font-size: 13px;
    color: var(--muted);
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    font-weight: 600;
    font-size: 14px;
  }
</style>
